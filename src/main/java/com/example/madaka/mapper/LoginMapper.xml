<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.madaka.mapper.LoginMapper">

  <select id="login" parameterType="com.example.madaka.mapper.LoginMapper">
    SELECT * FROM LOGIN_TBL WHERE emp_id = #{empId} AND password = #{password}
  </select>

</mapper>
